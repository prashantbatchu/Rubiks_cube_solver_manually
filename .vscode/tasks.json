{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Cube Solver",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "main.cpp",
                "src/Cube.cpp",
                "src/Solver.cpp",
                "src/Utils.cpp",
                "-I",
                "include",
                "-o",
                "cube"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
